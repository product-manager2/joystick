{
  "name": "joystick",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Joystick PWA and API",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "api:dev": "tsx watch server/main.ts",
    "api:start": "tsx server/main.ts",
    "worker:dev": "tsx watch server/worker.ts",
    "worker:start": "tsx server/worker.ts",
    "db:migrate": "tsx db/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json",
    "test:server": "tsx --test tests/server/*.test.ts",
    "agent:setup": "tsx server/setup-agent.ts",
    "api:build": "tsc -p tsconfig.server.json --noEmit false --outDir build --rootDir ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/websocket": "^11.2.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
