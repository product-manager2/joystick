DATABASE_URL=postgres://joystick:joystick@localhost:5432/joystick
# Production uses a direct PostgreSQL connection, not PgBouncer.
DIRECT_DATABASE_URL=
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
RP_ID=localhost
COOKIE_SECURE=false
# Enables simulated funding and payout using labeled test credits only.
GAME_TEST_CREDITS=true
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_ID=
ANTHROPIC_WORKFLOW_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_WORKSPACE_ID=
# Server-only Vercel AI Gateway key for optional Jev recommendation ordering.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
SUBMISSION_REVIEW_MODEL=claude-haiku-5-5
# Vercel uses same-origin /api HTTP rewrite; no API origin is needed by browser code.
VITE_API_ORIGIN=
# Production browser WebSocket connects directly to Fly. Leave blank for local Vite proxy.
VITE_WS_ORIGIN=
# For Vercel production set VITE_WS_ORIGIN=https://joystick-api.fly.dev
# Fly behind the Vercel HTTP rewrite: shared proxy IP quota plus per-email quota.
HTTP_PROXY_MODE=
# Optional. Generate a VAPID key pair once; keep the private key only in the API/worker environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A public HTTPS URL or mailto: contact for the Web Push application server.
VAPID_SUBJECT=
